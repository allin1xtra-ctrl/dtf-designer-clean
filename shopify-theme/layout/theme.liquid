<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page_title %}{{ page_title | escape }}{% else %}{{ shop.name | escape }}{% endif %}</title>
  <meta name="description" content="{% if page_description %}{{ page_description | escape }}{% else %}Your Favorite DTF Plug offers premium custom DTF transfers, gang sheets, and custom apparel printing with no minimums, vibrant color, easy artwork upload, and fast turnaround.{% endif %}">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if page_title %}{{ page_title | escape }}{% else %}{{ shop.name | escape }}{% endif %}">
  <meta property="og:description" content="{% if page_description %}{{ page_description | escape }}{% else %}Your Favorite DTF Plug offers premium custom DTF transfers, gang sheets, and custom apparel printing with no minimums, vibrant color, easy artwork upload, and fast turnaround.{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:image" content="{% if page_image %}{{ page_image | image_url: width: 1200 }}{% elsif shop.brand.logo %}{{ shop.brand.logo | image_url: width: 1200 }}{% else %}{{ shop.logo | image_url }}{% endif %}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if page_title %}{{ page_title | escape }}{% else %}{{ shop.name | escape }}{% endif %}">
  <meta name="twitter:description" content="{% if page_description %}{{ page_description | escape }}{% else %}Your Favorite DTF Plug offers premium custom DTF transfers, gang sheets, and custom apparel printing with no minimums, vibrant color, easy artwork upload, and fast turnaround.{% endif %}">
  <meta name="twitter:image" content="{% if page_image %}{{ page_image | image_url: width: 1200 }}{% elsif shop.brand.logo %}{{ shop.brand.logo | image_url: width: 1200 }}{% else %}{{ shop.logo | image_url }}{% endif %}">
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {{ shop.brand.logo | image_url: width: 600 | json }}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ shop.url | append: "/search?q={search_term_string}" | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
</head>

<body>
  <!-- Announcement Bar -->
  <div style="background:#00fff7;color:#18181b;text-align:center;padding:0.5rem 0;font-weight:700;letter-spacing:0.03em;">
    🚚 Free shipping on orders $99+ | 🎨 Try our new DTF Designer Pro!
  </div>

  <!-- Sticky Header -->
  <header style="position:sticky;top:0;z-index:1000;background:#18181b;padding:1rem 0 0.5rem 0;box-shadow:0 2px 12px #00fff733;">
    <div style="max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" style="font-size:1.5rem;font-weight:900;color:#00fff7;text-decoration:none;">{{ shop.name }}</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" aria-label="Go to homepage" style="color:#fff;margin-right:2rem;">Home</a>
        <a href="/pages/customizer" aria-label="Open the customizer page" style="color:#fff;margin-right:2rem;">Customizer</a>
        <a href="/collections/dtf-transfers" aria-label="Shop DTF transfers" style="color:#fff;margin-right:2rem;">DTF Transfers</a>
        <a href="/collections/apparel" aria-label="Shop custom apparel" style="color:#fff;margin-right:2rem;">Apparel</a>
        <a href="/collections/gang-sheets" aria-label="Shop gang sheets" style="color:#fff;margin-right:2rem;">Gang Sheets</a>
        <a href="/pages/how-to-order" aria-label="Read how to order" style="color:#fff;margin-right:2rem;">How To Order</a>
        <a href="/pages/contact" aria-label="Contact us" style="color:#fff;margin-right:2rem;">Contact</a>
        <a class="nav-pill" href="/cart" aria-label="View your shopping cart" style="color:#fff;">Cart</a>
      </nav>
    </div>
  </header>

  <!-- Accessibility: Skip to main content link -->
  <a href="#main-content" style="position:absolute;left:-999px;top:auto;width:1px;height:1px;overflow:hidden;background:#fff200;color:#18181b;z-index:10000;">Skip to main content</a>

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  <footer style="border-top:1px solid #2a2a2a;background:#121212;color:#d1d5db;padding:1.2rem 0;">
    <div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:0.8rem 1.4rem;align-items:center;justify-content:space-between;">
      <span>{{ shop.name }}</span>
      <nav aria-label="Footer navigation">
        <a href="/collections/all" style="color:#fff;margin-right:1rem;">Shop</a>
        <a href="/pages/contact" style="color:#fff;margin-right:1rem;">Contact</a>
        <a href="/policies/shipping-policy" style="color:#fff;margin-right:1rem;">Shipping</a>
        <a href="/policies/refund-policy" style="color:#fff;margin-right:1rem;">Refunds</a>
        <a href="/policies/privacy-policy" style="color:#fff;margin-right:1rem;">Privacy</a>
        <a href="/policies/terms-of-service" style="color:#fff;">Terms</a>
      </nav>
    </div>
  </footer>

  {{ content_for_footer }}

  <!-- DTF Designer Pro: Shopify cart + iframe postMessage bridge -->
  <script>
    (function () {
      'use strict';

      var IFRAME_SELECTOR = '#dtf-customizer-iframe, iframe[src*="dtf-designer"], iframe[src*="vercel.app"], iframe[src*="/customizer"]';
      var MAX_IFRAME_HEIGHT = 2400;
      var MIN_IFRAME_HEIGHT = 420;
      var isAddingToCart = false;

      function isAllowedDesignerOrigin(origin) {
        if (!origin || origin === 'null') return false;

        try {
          var url = new URL(origin);
          var host = url.hostname;

          if (host === window.location.hostname) return true;
          if (host === 'yourdtfplug.com' || host === 'www.yourdtfplug.com') return true;
          if (host === 'localhost' || host === '127.0.0.1') return true;
          if (host === 'dtf-designer-clean.vercel.app') return true;
          if (host === 'dtf-designer-pro.vercel.app') return true;
          if (host.indexOf('dtf-designer') !== -1 && host.slice(-11) === '.vercel.app') return true;

          return false;
        } catch (error) {
          return false;
        }
      }

      function normalizeVariantId(value) {
        var raw = String(value || '').trim();

        if (!raw) return '';

        if (raw.indexOf('gid://shopify/ProductVariant/') === 0) {
          return raw.split('/').pop();
        }

        return raw.replace(/[^0-9]/g, '');
      }

      function isDataUrl(value) {
        return typeof value === 'string' && value.trim().toLowerCase().indexOf('data:') === 0;
      }

      function cleanCartProperties(properties) {
        var cleaned = {};

        if (!properties || typeof properties !== 'object') {
          return cleaned;
        }

        Object.keys(properties).forEach(function (key) {
          var value = properties[key];

          if (value === null || value === undefined || value === '') return;

          if (isDataUrl(value)) {
            console.warn('[DTF cart bridge] Blocked data URL cart property:', key);
            return;
          }

          cleaned[key] = value;
        });

        return cleaned;
      }

      function normalizePayload(message) {
        if (message && message.data && typeof message.data === 'object') {
          return message.data;
        }

        return message || {};
      }

      function buildCartItems(payload) {
        var sharedQuantity = Math.max(1, Number(payload.quantity || 1));
        var sharedProperties = cleanCartProperties(payload.properties || {});

        if (Array.isArray(payload.items) && payload.items.length) {
          return payload.items
            .map(function (item) {
              var id = normalizeVariantId(item.id || item.variantId || item.variant_id);

              if (!id) return null;

              return {
                id: Number(id),
                quantity: Math.max(1, Number(item.quantity || sharedQuantity)),
                properties: cleanCartProperties(item.properties || sharedProperties)
              };
            })
            .filter(Boolean);
        }

        var variantId = normalizeVariantId(payload.id || payload.variantId || payload.variant_id);

        if (!variantId) return [];

        return [
          {
            id: Number(variantId),
            quantity: sharedQuantity,
            properties: sharedProperties
          }
        ];
      }

      function getCartRedirect(payload) {
        var redirect = payload.redirect || payload.redirectUrl || payload.redirect_url;

        if (typeof redirect === 'string' && redirect.charAt(0) === '/') {
          return redirect;
        }

        if (payload.checkout === true || payload.redirectToCheckout === true) {
          return '/checkout';
        }

        return '/cart';
      }

      function setIframeHeight(rawHeight) {
        var numberHeight = Number(rawHeight);

        if (!Number.isFinite(numberHeight) || numberHeight <= 0) return;

        var height = Math.max(MIN_IFRAME_HEIGHT, Math.min(Math.ceil(numberHeight), MAX_IFRAME_HEIGHT));
        var iframe = document.querySelector(IFRAME_SELECTOR);

        if (!iframe) return;

        iframe.style.height = height + 'px';
        iframe.style.minHeight = height + 'px';
      }

      function addItemsToCart(payload) {
        var items = buildCartItems(payload);

        if (!items.length) {
          console.error('[DTF cart bridge] Missing Shopify variant ID in payload:', payload);
          alert('Missing product variant. Please choose a product and try again.');
          return;
        }

        if (isAddingToCart) return;
        isAddingToCart = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          body: JSON.stringify({ items: items })
        })
          .then(function (response) {
            return response.json()
              .catch(function () {
                return {};
              })
              .then(function (body) {
                if (!response.ok) {
                  throw new Error(body.description || body.message || 'Shopify rejected add-to-cart');
                }

                return body;
              });
          })
          .then(function () {
            window.location.href = getCartRedirect(payload);
          })
          .catch(function (error) {
            isAddingToCart = false;
            console.error('[DTF cart bridge] Add to cart failed:', error);
            alert('Could not add your custom item to cart. Please try again.');
          });
      }

      window.addEventListener('message', function (event) {
        if (!isAllowedDesignerOrigin(event.origin)) return;

        var message = event.data || {};

        if (!message || typeof message !== 'object') return;

        if (message.type === 'DTF_IFRAME_HEIGHT') {
          setIframeHeight(message.height);
          return;
        }

        if (message.type === 'DTF_ADD_TO_CART') {
          addItemsToCart(normalizePayload(message));
        }
      });
    })();
  </script>
</body>
</html>
