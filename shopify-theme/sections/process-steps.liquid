{% liquid
  assign section_id = 'shopify-section-' | append: section.id
  assign bg_image = section.settings.background_image
%}

<style>
  #{{ section_id }} .yf-steps {
    --desktop-padding: {{ section.settings.desktop_spacing }}px;
    --mobile-padding: {{ section.settings.mobile_spacing }}px;
    --desktop-min-height: {{ section.settings.desktop_height }}px;
    --mobile-min-height: {{ section.settings.mobile_height }}px;
    --content-align: {{ section.settings.content_alignment }};
    --text-align: {{ section.settings.text_alignment }};
    --cta-justify: {{ section.settings.cta_alignment }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    margin: 0 auto;
    border-radius: 20px;
    min-height: var(--desktop-min-height);
    padding: var(--desktop-padding);
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .yf-steps::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {% if bg_image != blank %}url('{{ bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %};
    z-index: 0;
  }

  #{{ section_id }} .yf-steps::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: var(--overlay-opacity);
    z-index: 1;
  }

  #{{ section_id }} .yf-steps__inner {
    position: relative;
    z-index: 2;
    min-height: calc(var(--desktop-min-height) - (var(--desktop-padding) * 2));
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.content_position }};
    gap: 18px;
  }

  #{{ section_id }} .yf-steps__header {
    display: flex;
    flex-direction: column;
    align-items: var(--content-align);
    text-align: var(--text-align);
    gap: 8px;
  }

  #{{ section_id }} .yf-steps__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    align-items: {{ section.settings.vertical_alignment }};
  }

  #{{ section_id }} .yf-step {
    background: rgba(255, 255, 255, 0.9);
    color: #0f172a;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.28);
    padding: 14px;
    min-height: 100%;
  }

  #{{ section_id }} .yf-step__index {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #0f172a;
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 8px;
  }

  #{{ section_id }} .yf-steps__actions {
    display: flex;
    justify-content: var(--cta-justify);
  }

  #{{ section_id }} .yf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .yf-steps {
      min-height: var(--mobile-min-height);
      padding: var(--mobile-padding);
    }

    #{{ section_id }} .yf-steps__inner {
      min-height: calc(var(--mobile-min-height) - (var(--mobile-padding) * 2));
    }
  }
</style>

<section class="yf-steps page-width">
  <div class="yf-steps__inner">
    <header class="yf-steps__header">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </header>

    <div class="yf-steps__grid">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}
          <article class="yf-step" {{ block.shopify_attributes }}>
            <span class="yf-step__index">{{ forloop.index }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="yf-steps__actions">
        <a href="{{ section.settings.button_link | default: '/pages/customizer' }}" class="yf-btn">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Process steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How to order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple 3-step DTF workflow" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Upload, approve, and checkout with confidence." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Design Your Transfer Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f8fafc" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0f172a" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#0f172a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "start", "options": [{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 28, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 72, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 220, "max": 900, "step": 20, "default": 340, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 200, "max": 1100, "step": 20, "default": 320, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "checkbox", "id": "show_block", "label": "Show block", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "Upload your artwork" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Send your file and choose your options." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Process steps", "blocks": [{"type":"step"},{"type":"step"},{"type":"step"}] }
  ]
}
{% endschema %}
