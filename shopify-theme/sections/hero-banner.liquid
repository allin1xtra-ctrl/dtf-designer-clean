{% liquid
  assign section_id = 'shopify-section-' | append: section.id
  assign bg_image = section.settings.background_image
  assign hero_image = section.settings.hero_image
%}

<style>
  #{{ section_id }} .yf-hero {
    --desktop-padding: {{ section.settings.desktop_spacing }}px;
    --mobile-padding: {{ section.settings.mobile_spacing }}px;
    --desktop-min-height: {{ section.settings.desktop_height }}px;
    --mobile-min-height: {{ section.settings.mobile_height }}px;
    --content-justify: {{ section.settings.content_position }};
    --content-align: {{ section.settings.content_alignment }};
    --content-vertical: {{ section.settings.vertical_alignment }};
    --text-align: {{ section.settings.text_alignment }};
    --cta-justify: {{ section.settings.cta_alignment }};
    --image-position: {{ section.settings.image_alignment }} center;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    position: relative;
    overflow: hidden;
    margin: 0 auto;
    border-radius: 22px;
    min-height: var(--desktop-min-height);
    padding: var(--desktop-padding);
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .yf-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {% if bg_image != blank %}url('{{ bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %};
    z-index: 0;
  }

  #{{ section_id }} .yf-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: var(--overlay-opacity);
    z-index: 1;
  }

  #{{ section_id }} .yf-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(16px, 2vw, 28px);
    min-height: calc(var(--desktop-min-height) - (var(--desktop-padding) * 2));
    align-items: var(--content-vertical);
  }

  #{{ section_id }} .yf-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: var(--content-justify);
    align-items: var(--content-align);
    text-align: var(--text-align);
    gap: 14px;
  }

  #{{ section_id }} .yf-hero__kicker {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.95;
  }

  #{{ section_id }} .yf-hero__heading {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.08;
  }

  #{{ section_id }} .yf-hero__text {
    margin: 0;
    max-width: 58ch;
    opacity: 0.92;
  }

  #{{ section_id }} .yf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: var(--cta-justify);
    gap: 10px;
  }

  #{{ section_id }} .yf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  #{{ section_id }} .yf-btn:hover { transform: translateY(-1px); }

  #{{ section_id }} .yf-btn--primary {
    background: {{ section.settings.primary_button_background }};
    color: {{ section.settings.primary_button_text }};
  }

  #{{ section_id }} .yf-btn--secondary {
    background: {{ section.settings.secondary_button_background }};
    color: {{ section.settings.secondary_button_text }};
  }

  #{{ section_id }} .yf-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .yf-hero__img {
    width: 100%;
    max-width: 620px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: var(--image-position);
    border-radius: 18px;
    display: block;
  }

  #{{ section_id }} .yf-hero__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px dashed rgba(255, 255, 255, 0.3);
    display: grid;
    place-content: center;
    text-align: center;
    padding: 20px;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .yf-hero {
      min-height: var(--mobile-min-height);
      padding: var(--mobile-padding);
    }

    #{{ section_id }} .yf-hero__inner {
      grid-template-columns: 1fr;
      min-height: calc(var(--mobile-min-height) - (var(--mobile-padding) * 2));
    }
  }
</style>

<section class="yf-hero page-width">
  <div class="yf-hero__inner">
    <div class="yf-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="yf-hero__kicker">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="yf-hero__heading">{{ section.settings.heading }}</h1>
      <div class="yf-hero__text rte">{{ section.settings.text }}</div>

      <div class="yf-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a href="{{ section.settings.primary_link | default: '/pages/customizer' }}" class="yf-btn yf-btn--primary">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a href="{{ section.settings.secondary_link | default: '/collections/dtf-transfers' }}" class="yf-btn yf-btn--secondary">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="yf-hero__media">
      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 1400 | image_tag: class: 'yf-hero__img', loading: 'lazy', alt: hero_image.alt | default: section.settings.heading }}
      {% else %}
        <div class="yf-hero__placeholder">
          <strong>Upload a hero image</strong>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your Favorite DTF Plug" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop premium DTF transfers and custom apparel" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Professional, vibrant DTF printing with no minimums and fast turnaround.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Design Your Transfer Now" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Shop DTF Transfers" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#0f172a" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 35, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "primary_button_background", "label": "Primary button background", "default": "#06b6d4" },
    { "type": "color", "id": "primary_button_text", "label": "Primary button text", "default": "#0f172a" },
    { "type": "color", "id": "secondary_button_background", "label": "Secondary button background", "default": "#1e293b" },
    { "type": "color", "id": "secondary_button_text", "label": "Secondary button text", "default": "#ffffff" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "image_alignment", "label": "Image alignment", "default": "center", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 72, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 280, "max": 900, "step": 20, "default": 560, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 240, "max": 1100, "step": 20, "default": 640, "unit": "px" }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
