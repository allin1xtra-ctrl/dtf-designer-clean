{% liquid
  assign section_id = 'shopify-section-' | append: section.id
  assign bg_image = section.settings.background_image
%}

<style>
  #{{ section_id }} .yf-customizer-cta {
    --desktop-padding: {{ section.settings.desktop_spacing }}px;
    --mobile-padding: {{ section.settings.mobile_spacing }}px;
    --desktop-min-height: {{ section.settings.desktop_height }}px;
    --mobile-min-height: {{ section.settings.mobile_height }}px;
    --content-align: {{ section.settings.content_alignment }};
    --text-align: {{ section.settings.text_alignment }};
    --cta-justify: {{ section.settings.cta_alignment }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    margin: 0 auto;
    border-radius: 20px;
    min-height: var(--desktop-min-height);
    padding: var(--desktop-padding);
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .yf-customizer-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {% if bg_image != blank %}url('{{ bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %};
    z-index: 0;
  }

  #{{ section_id }} .yf-customizer-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: var(--overlay-opacity);
    z-index: 1;
  }

  #{{ section_id }} .yf-customizer-cta__inner {
    position: relative;
    z-index: 2;
    min-height: calc(var(--desktop-min-height) - (var(--desktop-padding) * 2));
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
    gap: 14px;
    align-items: {{ section.settings.vertical_alignment }};
  }

  #{{ section_id }} .yf-customizer-cta__content {
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.content_position }};
    align-items: var(--content-align);
    text-align: var(--text-align);
    gap: 10px;
  }

  #{{ section_id }} .yf-customizer-cta__side {
    padding: 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.24);
  }

  #{{ section_id }} .yf-customizer-cta__actions {
    display: flex;
    justify-content: var(--cta-justify);
  }

  #{{ section_id }} .yf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .yf-customizer-cta {
      min-height: var(--mobile-min-height);
      padding: var(--mobile-padding);
    }

    #{{ section_id }} .yf-customizer-cta__inner {
      grid-template-columns: 1fr;
      min-height: calc(var(--mobile-min-height) - (var(--mobile-padding) * 2));
    }
  }
</style>

<section class="yf-customizer-cta page-width">
  <div class="yf-customizer-cta__inner">
    <div class="yf-customizer-cta__content">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      <div class="yf-customizer-cta__actions">
        <a class="yf-btn" href="{{ section.settings.button_link | default: '/pages/customizer' }}">{{ section.settings.button_label }}</a>
      </div>
    </div>

    <aside class="yf-customizer-cta__side">
      <h3>{{ section.settings.side_title }}</h3>
      <p>{{ section.settings.side_text }}</p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Customizer CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customizer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design your transfer in minutes" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Launch the customizer and send artwork straight to checkout.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Design Your Transfer Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "side_title", "label": "Side title", "default": "Built for DTF workflow" },
    { "type": "textarea", "id": "side_text", "label": "Side text", "default": "Works for gang sheets, by-size transfers, and custom apparel." },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#0f172a" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 30, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#22d3ee" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0f172a" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "center", "options": [{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 72, "step": 2, "default": 18, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 220, "max": 900, "step": 20, "default": 320, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 200, "max": 1100, "step": 20, "default": 300, "unit": "px" }
  ],
  "presets": [
    { "name": "Customizer CTA" }
  ]
}
{% endschema %}
