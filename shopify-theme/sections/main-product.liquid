{% comment %}
  main-product.liquid — DTF Product Page (Theme 3.0)
  - Displays product image (square), title, price, description
  - Variant selector inside Add to Cart form
  - "🎨 Customize Now with DTF Designer" CTA → /pages/customizer (4 supported handles only)
  - Upload-only handle (dtf-gang-sheet-upload-print-ready-file) never shows the CTA
  - Reorder Last Design for logged-in customers with saved artwork URL
{% endcomment %}

{% assign customizer_handles = 'custom-dtf-transfer-by-size,dtf-gang-sheet-builder-build-your-own-sheet,custom-t-shirt-upload-customize,custom-hoodie-upload-customize' | split: ',' %}
{% assign current_handle = product.handle | downcase | strip %}
{% assign customizer_blocked = false %}
{% assign allowlist_match = false %}
{% assign failsafe_match = false %}
{% assign show_customizer = false %}
{% if current_handle contains 'upload-print-ready-file' %}
  {% assign customizer_blocked = true %}
{% endif %}
{% unless customizer_blocked %}
  {% for h in customizer_handles %}
    {% assign allowed_handle = h | downcase | strip %}
    {% if current_handle == allowed_handle %}
      {% assign allowlist_match = true %}
      {% assign show_customizer = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if show_customizer == false %}
    {% if current_handle contains 'custom-dtf-transfer' or current_handle contains 'gang-sheet-builder' or current_handle contains 'custom-t-shirt' or current_handle contains 'custom-hoodie' %}
      {% assign failsafe_match = true %}
      {% assign show_customizer = true %}
    {% endif %}
  {% endif %}
{% endunless %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign is_theme_preview = false %}
{% if request.design_mode or content_for_header contains 'previewBarInjector.init();' %}
  {% assign is_theme_preview = true %}
{% endif %}
{% if is_theme_preview %}
  <!-- DTF customizer CTA debug: handle={{ current_handle }}, blocked={{ customizer_blocked }}, allowlist_match={{ allowlist_match }}, failsafe_match={{ failsafe_match }}, show_customizer={{ show_customizer }} -->
{% endif %}

<div class="dtf-product-section">
  <div class="dtf-product-grid">

    <!-- Left: Product Media (square) -->
    <div class="dtf-product-media">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
          width="900"
          height="900"
          loading="eager"
          class="dtf-product-img"
        >
      {% else %}
        <div class="dtf-product-img dtf-img-placeholder"></div>
      {% endif %}
    </div>

    <!-- Right: Product Info -->
    <div class="dtf-product-info">

      <!-- Product Title -->
      <h1 class="dtf-product-title">{{ product.title }}</h1>

      <!-- Price -->
      <div id="dtf-price-display" class="dtf-price-display">
        {{ current_variant.price | money }}
      </div>

      <!-- Description -->
      {% if product.description != blank %}
        <div class="dtf-product-description">{{ product.description }}</div>
      {% endif %}

      <!-- Variant selector + Quantity + Add to Cart -->
      <form id="dtf-add-to-cart-form" method="post" action="/cart/add">
        {%- if product.variants.size > 1 -%}
          <label for="dtf-variant-select" class="dtf-label">Select Size:</label>
          <select id="dtf-variant-select" name="id" class="dtf-select">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-customizer-price="{{ variant.price | money_without_currency }}"
                {% if variant == current_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }}{% unless variant.available %} — Sold Out{% endunless %}
              </option>
            {% endfor %}
          </select>
        {%- else -%}
          <input type="hidden" name="id" id="dtf-variant-select" value="{{ product.variants.first.id }}">
        {%- endif -%}

        <label for="dtf-quantity" class="dtf-label">Quantity:</label>
        <input
          id="dtf-quantity"
          type="number"
          name="quantity"
          value="1"
          min="1"
          class="dtf-qty-input"
        >

        <button type="submit" class="dtf-size-btn dtf-cart-btn">🛒 Add to Cart</button>

        <!-- Customize Now CTA (supported products only) -->
        {% if show_customizer %}
          <a
            id="dtf-customize-btn"
            class="dtf-size-btn dtf-customize-btn"
            href="{{ routes.root_url }}pages/customizer?source=shopify&product={{ product.handle | url_encode }}&variant={{ current_variant.id }}&product_id={{ product.id }}&price={{ current_variant.price | money_without_currency | url_encode }}"
          >
            🎨 Customize &amp; Upload Design
          </a>
        {% endif %}
      </form>

      <!-- Reorder Last Design (logged-in customers only) -->
      {% if customer and customer.orders_count > 0 %}
        {% assign last_order = customer.orders.first %}
        {% assign last_line  = last_order.line_items.first %}
        {% assign artwork_url = last_line.properties | where: "name", "_Artwork URL" | map: "value" | first %}
        <div class="dtf-reorder-wrap">
          {% if artwork_url %}
            <a class="dtf-size-btn dtf-reorder-btn"
               href="/pages/customizer?source=shopify&reorder=true&artwork={{ artwork_url | url_encode }}&variant={{ last_line.variant_id }}&product={{ product.handle | url_encode }}&product_id={{ product.id }}">
              🔁 Reorder Last Design
            </a>
          {% else %}
            <a class="dtf-size-btn dtf-reorder-btn"
               href="/cart/add?id={{ last_line.variant_id }}&quantity=1">
              🔁 Reorder Last Size
            </a>
          {% endif %}
        </div>
      {% endif %}

    </div><!-- /.dtf-product-info -->
  </div><!-- /.dtf-product-grid -->
</div>

<style>
/* ─── Outer wrapper ─────────────────────────────────────── */
.dtf-product-section {
  background: #18181b;
  border: 2px solid #00fff7;
  box-shadow: 0 0 32px #00fff725;
  border-radius: 1.5rem;
  padding: 2.5rem 2.5rem 2rem;
  color: #fff;
  margin: 2rem auto;
  max-width: 1100px;
  box-sizing: border-box;
}

/* ─── Two-column grid ───────────────────────────────────── */
.dtf-product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem;
  align-items: start;
}

/* ─── Left column: media ────────────────────────────────── */
.dtf-product-media {
  position: sticky;
  top: 1.5rem;
}
.dtf-product-img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 1.25rem;
  display: block;
  border: 1.5px solid #00fff740;
}
.dtf-img-placeholder {
  background: #27272a;
  border: 1.5px dashed #00fff740;
}

/* ─── Right column: info ────────────────────────────────── */
.dtf-product-info {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.dtf-product-title {
  font-size: 1.9rem;
  font-weight: 800;
  margin: 0 0 0.5rem;
  color: #fff200;
  line-height: 1.2;
}

.dtf-price-display {
  font-size: 1.5rem;
  font-weight: 800;
  color: #00fff7;
  margin-bottom: 0.9rem;
}

.dtf-product-description {
  font-size: 0.95rem;
  color: #b3b3b3;
  margin-bottom: 1.25rem;
  line-height: 1.6;
}

/* ─── Form controls ─────────────────────────────────────── */
.dtf-label {
  color: #00fff7;
  font-weight: 700;
  display: block;
  margin-bottom: 0.35rem;
  font-size: 0.9rem;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.dtf-select {
  width: 100%;
  padding: 0.65rem 1rem;
  border-radius: 0.75rem;
  background: #27272a;
  color: #fff;
  border: 1.5px solid #00fff7;
  font-size: 1rem;
  margin-bottom: 1rem;
  box-sizing: border-box;
  appearance: none;
  cursor: pointer;
}
.dtf-select:focus {
  outline: none;
  border-color: #fff200;
}

.dtf-qty-input {
  width: 5rem;
  padding: 0.6rem 0.75rem;
  border-radius: 0.75rem;
  background: #27272a;
  color: #fff;
  border: 1.5px solid #00fff7;
  font-size: 1rem;
  margin-bottom: 1rem;
  box-sizing: border-box;
  text-align: center;
}
.dtf-qty-input:focus {
  outline: none;
  border-color: #fff200;
}

/* ─── Buttons ───────────────────────────────────────────── */
.dtf-size-btn {
  display: block;
  width: 100%;
  background: linear-gradient(90deg, #00fff7 0%, #fff200 100%);
  color: #18181b;
  font-weight: 800;
  border: none;
  border-radius: 0.85rem;
  padding: 0.95rem 0;
  font-size: 1.1rem;
  margin-top: 0.6rem;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  letter-spacing: 0.02em;
  transition: filter 0.18s, transform 0.15s;
  box-sizing: border-box;
}
.dtf-size-btn:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
  color: #18181b;
  text-decoration: none;
}
.dtf-size-btn:active {
  transform: translateY(0);
  filter: brightness(0.95);
}

.dtf-cart-btn {
  margin-top: 0.5rem;
}

.dtf-customize-btn {
  background: linear-gradient(90deg, #a855f7 0%, #6366f1 100%);
  color: #fff;
  margin-top: 0.75rem;
}
.dtf-customize-btn:hover {
  filter: brightness(1.12);
  color: #fff;
}

.dtf-reorder-wrap {
  margin-top: 0.75rem;
}
.dtf-reorder-btn {
  background: linear-gradient(90deg, #fff200 0%, #ffe000 100%);
  color: #18181b;
}
.dtf-reorder-btn:hover {
  filter: brightness(1.08);
  color: #18181b;
}

/* ─── Mobile ────────────────────────────────────────────── */
@media (max-width: 768px) {
  .dtf-product-section {
    padding: 1.25rem 1rem 1.25rem;
    margin: 0.75rem;
    border-radius: 1rem;
  }
  .dtf-product-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .dtf-product-media {
    position: static;
  }
  .dtf-product-title {
    font-size: 1.45rem;
  }
  .dtf-price-display {
    font-size: 1.25rem;
  }
  .dtf-size-btn {
    font-size: 1rem;
    padding: 1rem 0;
  }
}
</style>

<script>
(function () {
  var select       = document.getElementById('dtf-variant-select');
  var customizeBtn = document.getElementById('dtf-customize-btn');
  var priceDisplay = document.getElementById('dtf-price-display');
  var customizerBaseUrl = {{ routes.root_url | append: 'pages/customizer?source=shopify' | json }};
  var productHandle = {{ product.handle | json }};
  var productId    = {{ product.id | json }};

  if (!select || select.tagName !== 'SELECT') return;

  select.addEventListener('change', function () {
    var variantId = select.value;
    var selectedOption = select.options[select.selectedIndex];

    if (customizeBtn) {
      customizeBtn.href = customizerBaseUrl
        + '&product=' + encodeURIComponent(productHandle)
        + '&variant=' + encodeURIComponent(variantId)
        + '&product_id=' + encodeURIComponent(productId)
        + '&price=' + encodeURIComponent(selectedOption.dataset.customizerPrice || '');
    }

    if (priceDisplay && selectedOption.dataset.price) {
      priceDisplay.textContent = selectedOption.dataset.price;
    }
  });
})();
</script>

{% schema %}
{
  "name": "Main product",
  "settings": [],
  "presets": [{ "name": "Main product" }]
}
{% endschema %}
