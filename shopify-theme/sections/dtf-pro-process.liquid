{% liquid
  assign product_url = section.settings.product_url | default: '/pages/customizer'
  assign process_bg_image = section.settings.background_image
%}

<style>
#shopify-section-{{ section.id }} .dtf-process-section {
  --desktop-padding: {{ section.settings.desktop_spacing }}px;
  --mobile-padding: {{ section.settings.mobile_spacing }}px;
  --desktop-min-height: {{ section.settings.desktop_height }}px;
  --mobile-min-height: {{ section.settings.mobile_height }}px;
  --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  margin: 16px auto;
  padding: var(--desktop-padding);
  min-height: var(--desktop-min-height);
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  border-radius: 20px;
  position: relative;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .dtf-process-section::before { content:''; position:absolute; inset:0; background:{% if process_bg_image != blank %}url('{{ process_bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %}; z-index:0; }
#shopify-section-{{ section.id }} .dtf-process-section::after { content:''; position:absolute; inset:0; background:{{ section.settings.overlay_color }}; opacity:var(--overlay-opacity); z-index:1; }
#shopify-section-{{ section.id }} .dtf-process-section > * { position:relative; z-index:2; }
#shopify-section-{{ section.id }} .dtf-section-header { text-align: {{ section.settings.text_alignment }}; align-items: {{ section.settings.content_alignment }}; display:flex; flex-direction:column; }
#shopify-section-{{ section.id }} .dtf-process-grid { align-items: {{ section.settings.vertical_alignment }}; }
#shopify-section-{{ section.id }} .dtf-process-footer { text-align: {{ section.settings.cta_alignment }}; }
@media (max-width: 989px) { #shopify-section-{{ section.id }} .dtf-process-section { padding: var(--mobile-padding); min-height: var(--mobile-min-height); } }
</style>

<section class="dtf-process-section page-width">
  <div class="dtf-section-header">
    <p class="dtf-section-kicker">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
  </div>

  <div class="dtf-process-grid">
    {% for block in section.blocks %}
      {% if block.settings.show_block %}
        <article class="dtf-process-card" {{ block.shopify_attributes }}>
          <span class="dtf-process-number">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <div class="dtf-process-footer">
    <a href="{{ product_url }}" class="dtf-button dtf-button-primary">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "DTF Pro process",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "HOW TO ORDER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Your Custom DTF Order Works" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Choose your product, upload artwork, customize your print, checkout securely, and we print and ship with fast turnaround." },
    { "type": "url", "id": "product_url", "label": "Designer URL" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Design Your Transfer Now" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "start", "options": [{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 28, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 80, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 220, "max": 1000, "step": 20, "default": 340, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 240, "max": 1300, "step": 20, "default": 360, "unit": "px" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0f172a" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "checkbox", "id": "show_block", "label": "Show block", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your product" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Select a DTF transfer, gang sheet, custom t-shirt, hoodie, or apparel option." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "DTF Pro process" }]
}
{% endschema %}
