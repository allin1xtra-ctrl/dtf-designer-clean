{% liquid
  assign section_id = 'shopify-section-' | append: section.id
  assign bg_image = section.settings.background_image
%}

<style>
  #{{ section_id }} .yf-collections {
    --desktop-padding: {{ section.settings.desktop_spacing }}px;
    --mobile-padding: {{ section.settings.mobile_spacing }}px;
    --desktop-min-height: {{ section.settings.desktop_height }}px;
    --mobile-min-height: {{ section.settings.mobile_height }}px;
    --content-align: {{ section.settings.content_alignment }};
    --text-align: {{ section.settings.text_alignment }};
    --cta-justify: {{ section.settings.cta_alignment }};
    --image-position: {{ section.settings.image_alignment }} center;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    position: relative;
    overflow: hidden;
    margin: 0 auto;
    border-radius: 20px;
    min-height: var(--desktop-min-height);
    padding: var(--desktop-padding);
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .yf-collections::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {% if bg_image != blank %}url('{{ bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %};
    z-index: 0;
  }

  #{{ section_id }} .yf-collections::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: var(--overlay-opacity);
    z-index: 1;
  }

  #{{ section_id }} .yf-collections__inner {
    position: relative;
    z-index: 2;
    min-height: calc(var(--desktop-min-height) - (var(--desktop-padding) * 2));
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.content_position }};
    gap: 18px;
  }

  #{{ section_id }} .yf-collections__header {
    display: flex;
    flex-direction: column;
    align-items: var(--content-align);
    text-align: var(--text-align);
    gap: 10px;
  }

  #{{ section_id }} .yf-collections__kicker {
    margin: 0;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
  }

  #{{ section_id }} .yf-collections__heading,
  #{{ section_id }} .yf-collections__text {
    margin: 0;
    max-width: 70ch;
  }

  #{{ section_id }} .yf-collections__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  #{{ section_id }} .yf-collection-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    padding: 16px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(148, 163, 184, 0.25);
    min-height: 100%;
  }

  #{{ section_id }} .yf-collection-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: var(--image-position);
    border-radius: 12px;
  }

  #{{ section_id }} .yf-collections__actions {
    display: flex;
    justify-content: var(--cta-justify);
    flex-wrap: wrap;
    gap: 10px;
  }

  #{{ section_id }} .yf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .yf-collections {
      min-height: var(--mobile-min-height);
      padding: var(--mobile-padding);
    }

    #{{ section_id }} .yf-collections__inner {
      min-height: calc(var(--mobile-min-height) - (var(--mobile-padding) * 2));
    }
  }
</style>

<section class="yf-collections page-width">
  <div class="yf-collections__inner">
    <header class="yf-collections__header">
      {% if section.settings.eyebrow != blank %}
        <p class="yf-collections__kicker">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="yf-collections__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p class="yf-collections__text">{{ section.settings.text }}</p>
      {% endif %}
    </header>

    <div class="yf-collections__grid">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}
          {% assign collection_obj = collections[block.settings.collection] %}
          {% assign card_link = block.settings.link %}
          {% if card_link == blank and collection_obj %}
            {% assign card_link = collection_obj.url %}
          {% endif %}
          <a href="{{ card_link | default: '/collections/all' }}" class="yf-collection-card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: class: 'yf-collection-card__image', loading: 'lazy', alt: block.settings.title }}
            {% elsif collection_obj and collection_obj.image %}
              {{ collection_obj.image | image_url: width: 900 | image_tag: class: 'yf-collection-card__image', loading: 'lazy', alt: block.settings.title | default: collection_obj.title }}
            {% endif %}
            <strong>{{ block.settings.title | default: collection_obj.title }}</strong>
            <span>{{ block.settings.text }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="yf-collections__actions">
        <a class="yf-btn" href="{{ section.settings.button_link | default: '/collections/dtf-transfers' }}">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collections grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Browse DTF transfers, gang sheets, and custom apparel." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop DTF Transfers" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f8fafc" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0f172a" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#0f172a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "image_alignment", "label": "Image alignment", "default": "center", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 72, "step": 2, "default": 18, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 220, "max": 900, "step": 20, "default": 420, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 200, "max": 1100, "step": 20, "default": 360, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        { "type": "checkbox", "id": "show_block", "label": "Show block", "default": true },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Collections grid", "blocks": [{"type":"card"},{"type":"card"},{"type":"card"}] }
  ]
}
{% endschema %}
