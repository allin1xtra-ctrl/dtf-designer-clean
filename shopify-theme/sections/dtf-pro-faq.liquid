{% liquid
  assign product_url = section.settings.product_url | default: '/pages/customizer'
  assign faq_bg_image = section.settings.background_image
%}

<style>
#shopify-section-{{ section.id }} .dtf-faq-section {
  --desktop-padding: {{ section.settings.desktop_spacing }}px;
  --mobile-padding: {{ section.settings.mobile_spacing }}px;
  --desktop-min-height: {{ section.settings.desktop_height }}px;
  --mobile-min-height: {{ section.settings.mobile_height }}px;
  --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  margin: 16px auto;
  padding: var(--desktop-padding);
  min-height: var(--desktop-min-height);
  border-radius: 20px;
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  position: relative;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .dtf-faq-section::before { content:''; position:absolute; inset:0; background:{% if faq_bg_image != blank %}url('{{ faq_bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %}; z-index:0; }
#shopify-section-{{ section.id }} .dtf-faq-section::after { content:''; position:absolute; inset:0; background:{{ section.settings.overlay_color }}; opacity:var(--overlay-opacity); z-index:1; }
#shopify-section-{{ section.id }} .dtf-faq-section > * { position:relative; z-index:2; }
#shopify-section-{{ section.id }} .dtf-faq-copy { display:flex; flex-direction:column; justify-content:{{ section.settings.content_position }}; align-items:{{ section.settings.content_alignment }}; text-align:{{ section.settings.text_alignment }}; }
#shopify-section-{{ section.id }} .dtf-faq-grid { align-items: {{ section.settings.vertical_alignment }}; }
#shopify-section-{{ section.id }} .dtf-faq-copy .dtf-button { align-self: {{ section.settings.cta_alignment }}; }
@media (max-width: 989px) { #shopify-section-{{ section.id }} .dtf-faq-section { padding: var(--mobile-padding); min-height: var(--mobile-min-height); } }
</style>

<section class="dtf-faq-section page-width">
  <div class="dtf-faq-grid">
    <div class="dtf-faq-copy">
      <p class="dtf-section-kicker">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
      <a href="{{ product_url }}" class="dtf-button dtf-button-primary">{{ section.settings.cta_label }}</a>
    </div>

    <div class="dtf-faq-list">
      {% for block in section.blocks %}
        {% if block.settings.show_block %}
          <details class="dtf-faq-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="dtf-faq-answer rte"><p>{{ block.settings.answer }}</p></div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% assign faq_json_items = '' %}
{% for block in section.blocks %}
  {% if block.settings.show_block %}
    {% capture faq_json_item %}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip_html | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }
    {% endcapture %}
    {% if faq_json_items != '' %}
      {% assign faq_json_items = faq_json_items | append: ',' %}
    {% endif %}
    {% assign faq_json_items = faq_json_items | append: faq_json_item %}
  {% endif %}
{% endfor %}

{% if faq_json_items != '' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_json_items }}]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "DTF Pro FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FREQUENTLY ASKED QUESTIONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ: Custom DTF Transfers, Gang Sheets, and Apparel Printing" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Answer top buyer questions about artwork requirements, turnaround, pressing, and ordering before checkout." },
    { "type": "url", "id": "product_url", "label": "Designer URL" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Design Your Transfer Now" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "start", "options": [{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 80, "step": 2, "default": 14, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 220, "max": 1100, "step": 20, "default": 420, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 240, "max": 1400, "step": 20, "default": 480, "unit": "px" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0f172a" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "checkbox", "id": "show_block", "label": "Show block", "default": true },
        { "type": "text", "id": "question", "label": "Question", "default": "How do I place a custom DTF order?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Choose your product, upload print-ready artwork, customize size and placement, then add the order to your Shopify cart." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "DTF Pro FAQ" }]
}
{% endschema %}
