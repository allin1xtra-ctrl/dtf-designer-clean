{% liquid
  assign apparel_url = section.settings.custom_drip_url | default: '/collections/apparel'
  assign transfer_url = section.settings.custom_transfers_url | default: '/collections/dtf-transfers'
  assign premade_transfer_url = section.settings.premade_transfers_url | default: '/collections/dtf-transfers'
  assign gang_sheet_url = section.settings.gang_sheets_url | default: '/collections/gang-sheets'
  assign starter_pack_url = section.settings.starter_packs_url | default: '/pages/customizer'
  assign transfer_joiner = '?'
  if transfer_url contains '?'
    assign transfer_joiner = '&'
  endif
  assign customize_url = starter_pack_url
  assign upload_url = transfer_url | append: transfer_joiner | append: 'dtf_mode=transfer&upload=1#dtf-designer'
  assign hero_bg_image = section.settings.background_image
%}

{{ 'dtf-pro-theme.css' | asset_url | stylesheet_tag }}

<style>
#shopify-section-{{ section.id }} .dtf-hero-section {
  --desktop-padding: {{ section.settings.desktop_spacing }}px;
  --mobile-padding: {{ section.settings.mobile_spacing }}px;
  --desktop-min-height: {{ section.settings.desktop_height }}px;
  --mobile-min-height: {{ section.settings.mobile_height }}px;
  --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  margin: 16px auto;
  padding: var(--desktop-padding);
  min-height: var(--desktop-min-height);
  border-radius: 22px;
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.3);
}

#shopify-section-{{ section.id }} .dtf-hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: {% if hero_bg_image != blank %}url('{{ hero_bg_image | image_url: width: 2200 }}') center/cover no-repeat{% else %}transparent{% endif %};
  z-index: 0;
}

#shopify-section-{{ section.id }} .dtf-hero-section::after {
  content: '';
  position: absolute;
  inset: 0;
  background: {{ section.settings.overlay_color }};
  opacity: var(--overlay-opacity);
  z-index: 1;
}

#shopify-section-{{ section.id }} .dtf-hero-shell {
  position: relative;
  z-index: 2;
  min-height: calc(var(--desktop-min-height) - (var(--desktop-padding) * 2));
  align-items: {{ section.settings.vertical_alignment }};
}

#shopify-section-{{ section.id }} .dtf-hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: {{ section.settings.content_position }};
  align-items: {{ section.settings.content_alignment }};
  text-align: {{ section.settings.text_alignment }};
}

#shopify-section-{{ section.id }} .dtf-hero-actions {
  justify-content: {{ section.settings.cta_alignment }};
}

#shopify-section-{{ section.id }} .dtf-hero-image {
  object-position: {{ section.settings.image_alignment }} center;
}

@media (max-width: 989px) {
  #shopify-section-{{ section.id }} .dtf-hero-section {
    padding: var(--mobile-padding);
    min-height: var(--mobile-min-height);
  }

  #shopify-section-{{ section.id }} .dtf-hero-shell {
    min-height: calc(var(--mobile-min-height) - (var(--mobile-padding) * 2));
  }
}
</style>

<section class="dtf-hero-section">
  <div class="dtf-hero-shell page-width">
    <div class="dtf-hero-copy">
      {% if section.settings.kicker != blank %}
        <p class="dtf-hero-kicker">{{ section.settings.kicker }}</p>
      {% endif %}

      <h1>{{ section.settings.heading }}</h1>
      <div class="dtf-hero-text rte">{{ section.settings.text }}</div>

      <div class="dtf-hero-actions">
        <a href="{{ customize_url }}" class="dtf-button dtf-button-primary">
          {{ section.settings.customize_label }}
        </a>
        <a href="{{ upload_url }}" class="dtf-button dtf-button-secondary">
          {{ section.settings.upload_label }}
        </a>
      </div>

      <div class="dtf-hero-stats" role="list">
        <div class="dtf-stat-card" role="listitem">
          <strong>{{ section.settings.stat_one_value }}</strong>
          <span>{{ section.settings.stat_one_label }}</span>
        </div>
        <div class="dtf-stat-card" role="listitem">
          <strong>{{ section.settings.stat_two_value }}</strong>
          <span>{{ section.settings.stat_two_label }}</span>
        </div>
        <div class="dtf-stat-card" role="listitem">
          <strong>{{ section.settings.stat_three_value }}</strong>
          <span>{{ section.settings.stat_three_label }}</span>
        </div>
      </div>

      <ul class="dtf-hero-points" role="list">
        <li>{{ section.settings.point_one }}</li>
        <li>{{ section.settings.point_two }}</li>
        <li>{{ section.settings.point_three }}</li>
      </ul>
    </div>

    <div class="dtf-hero-card">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'dtf-hero-image', loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        <div class="dtf-hero-placeholder">
          <div class="dtf-chip">DTF Designer Pro</div>
          <strong>Launch fast custom transfer and apparel orders from one premium product page.</strong>
        </div>
      {% endif %}

      <div class="dtf-order-rail">
        <a href="{{ customize_url }}" class="dtf-order-card">
          <span class="dtf-order-title">Custom apparel</span>
          <small>Shop custom t-shirts and hoodies</small>
        </a>
        <a href="{{ premade_transfer_url }}" class="dtf-order-card">
          <span class="dtf-order-title">DTF transfers</span>
          <small>Order print-ready transfer sizes fast</small>
        </a>
        <a href="{{ transfer_url }}" class="dtf-order-card">
          <span class="dtf-order-title">Upload DTF artwork</span>
          <small>Start a no-minimum custom transfer order</small>
        </a>
        <a href="{{ gang_sheet_url }}" class="dtf-order-card">
          <span class="dtf-order-title">DTF gang sheets</span>
          <small>Build your own gang sheet online</small>
        </a>
        <a href="{{ starter_pack_url }}" class="dtf-order-card">
          <span class="dtf-order-title">Customize &amp; upload design</span>
          <small>Launch the DTF Designer Pro workflow</small>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DTF Pro hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "YOUR FAVORITE DTF PLUG" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Custom DTF Transfers Made Easy" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Upload your artwork, build gang sheets, customize apparel, and get vibrant ready-to-press transfers with no minimums and fast turnaround.</p>" },
    { "type": "url", "id": "custom_drip_url", "label": "Custom apparel collection URL" },
    { "type": "url", "id": "custom_transfers_url", "label": "Custom Transfers URL" },
    { "type": "url", "id": "premade_transfers_url", "label": "Pre-made Transfers URL" },
    { "type": "url", "id": "gang_sheets_url", "label": "Gang Sheets URL" },
    { "type": "url", "id": "starter_packs_url", "label": "Customizer URL" },
    { "type": "text", "id": "customize_label", "label": "Primary CTA label", "default": "Design Your Transfer Now" },
    { "type": "text", "id": "upload_label", "label": "Secondary CTA label", "default": "Shop DTF Transfers" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "stat_one_value", "label": "Stat 1 value", "default": "No minimums" },
    { "type": "text", "id": "stat_one_label", "label": "Stat 1 label", "default": "Order any quantity" },
    { "type": "text", "id": "stat_two_value", "label": "Stat 2 value", "default": "Fast turnaround" },
    { "type": "text", "id": "stat_two_label", "label": "Stat 2 label", "default": "Production starts quickly" },
    { "type": "text", "id": "stat_three_value", "label": "Stat 3 value", "default": "Vibrant color" },
    { "type": "text", "id": "stat_three_label", "label": "Stat 3 label", "default": "Premium ready-to-press quality" },
    { "type": "text", "id": "point_one", "label": "Point 1", "default": "Custom DTF transfers and gang sheets for every order size" },
    { "type": "text", "id": "point_two", "label": "Point 2", "default": "Custom t-shirts and hoodies with full-color artwork upload" },
    { "type": "text", "id": "point_three", "label": "Point 3", "default": "Simple online design flow with secure Shopify checkout" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "center", "options": [{"value":"start","label":"Top"},{"value":"center","label":"Center"},{"value":"end","label":"Bottom"}] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "cta_alignment", "label": "CTA alignment", "default": "flex-start", "options": [{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}] },
    { "type": "select", "id": "image_alignment", "label": "Image alignment", "default": "center", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 120, "step": 4, "default": 28, "unit": "px" },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 8, "max": 80, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 320, "max": 1100, "step": 20, "default": 620, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile section height", "min": 360, "max": 1400, "step": 20, "default": 780, "unit": "px" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0f172a" }
  ],
  "presets": [
    { "name": "DTF Pro hero" }
  ]
}
{% endschema %}
