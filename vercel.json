{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://ta-apparel.com https://www.ta-apparel.com https://*.myshopify.com https://admin.shopify.com"
        }
      ]
    }
  ]
}
