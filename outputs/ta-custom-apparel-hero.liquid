<section class="ta-custom-hero" aria-labelledby="ta-custom-hero-title">
  <div class="ta-custom-hero__copy">
    <p>{{ section.settings.eyebrow | escape }}</p>
    <h2 id="ta-custom-hero-title">{{ section.settings.heading | escape }}</h2>
    <div>{{ section.settings.text }}</div>
    {%- assign studio_link = section.settings.link | default: '/pages/customizer?view=apparel-studio' -%}
    <a href="{{ studio_link }}">{{ section.settings.link_label | escape }}</a>
  </div>
  <div class="ta-custom-hero__visual" aria-hidden="true">
    <span>FRONT</span><span>BACK</span><span>SLEEVES</span><span>NECK</span>
    <strong>MAKE<br>IT<br>YOURS.</strong>
  </div>
</section>

{% stylesheet %}
  .ta-custom-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.8fr);background:#101916;color:#f7f3eb;min-height:560px;overflow:hidden}.ta-custom-hero__copy{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:clamp(50px,8vw,120px)}.ta-custom-hero__copy>p{color:#f3ac7c;text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:700}.ta-custom-hero h2{font-size:clamp(44px,6vw,88px);line-height:.94;max-width:760px;margin:12px 0 24px}.ta-custom-hero__copy div{max-width:650px;font-size:18px;line-height:1.6}.ta-custom-hero a{margin-top:28px;background:#f3ac7c;color:#24180d;padding:15px 24px;text-decoration:none;font-weight:700;border-radius:4px}.ta-custom-hero__visual{position:relative;display:grid;place-items:center;background:linear-gradient(135deg,#24352b,#0b1210);border-left:1px solid #546158}.ta-custom-hero__visual strong{font-size:clamp(62px,8vw,126px);line-height:.78;color:#f3ac7c;text-align:center}.ta-custom-hero__visual span{position:absolute;border:1px solid #718075;border-radius:999px;padding:7px 11px;font-size:11px;letter-spacing:.12em}.ta-custom-hero__visual span:nth-child(1){top:11%;left:10%}.ta-custom-hero__visual span:nth-child(2){top:17%;right:10%}.ta-custom-hero__visual span:nth-child(3){bottom:16%;left:8%}.ta-custom-hero__visual span:nth-child(4){bottom:10%;right:12%}@media(max-width:749px){.ta-custom-hero{grid-template-columns:1fr}.ta-custom-hero__copy{padding:50px 22px}.ta-custom-hero__visual{min-height:330px;border-left:0;border-top:1px solid #546158}}
{% endstylesheet %}

{% schema %}
{"name":"Custom apparel hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"New · Custom apparel studio"},{"type":"text","id":"heading","label":"Heading","default":"Wear your own proof."},{"type":"richtext","id":"text","label":"Text","default":"<p>Create custom apparel with artwork on the front, back, both sleeves, and neck. Preview every placement before you send it to our team.</p>"},{"type":"text","id":"link_label","label":"Button label","default":"Start customizing"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Custom apparel hero"}]}
{% endschema %}
