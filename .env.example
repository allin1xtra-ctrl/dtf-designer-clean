# Owner signup — 9-digit email verification (Preview only)
# RESEND_API_KEY: get from https://resend.com/api-keys
RESEND_API_KEY=
# Email address of the owner who is allowed to sign up
OWNER_EMAIL=
# "From" address for verification emails (must be a verified Resend sender)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Secret used to sign owner session cookies (falls back to ADMIN_SESSION_SECRET)
OWNER_SESSION_SECRET=

APP_AUTOMATION_TOKEN=
ADMIN_PANEL_TOKEN=
ADMIN_SESSION_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_VERSION=
# Shopify OAuth (required for the Connect Shopify install flow)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Vercel KV (required for OAuth token persistence)
KV_REST_API_URL=
KV_REST_API_TOKEN=
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_STAGING_FOLDER=
ADMIN_CUSTOMIZER_SUPABASE_URL=
ADMIN_CUSTOMIZER_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
